#!/bin/sh
case "$2" in type-at|refs|symbol) ;; *) exec agentica "$@";; esac
dir=$PWD
marker="$dir/running.$$"
touch "$marker"
trap 'rm -f "$marker"' EXIT
trap 'exit 143' TERM
running=$(find "$dir" -name 'running.*' | wc -l)
if [ "$running" -gt 4 ]; then
  echo "agentica: more than 4 queries at once" >&2
  exit 2
fi
sleep 1
agentica "$@"
status=$?
exit "$status"
