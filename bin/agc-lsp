#!/usr/bin/env bash
set -euo pipefail

script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case $target in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
root=$(cd "$(dirname "$script")/.." && pwd -P)
agentica=${AGENTICA:-agentica}
cache=${XDG_CACHE_HOME:-${HOME:?HOME is not set}/.cache}/agc-lsp
keep_days=30

digest() {
  if command -v sha256sum > /dev/null 2>&1; then
    sha256sum | cut -d ' ' -f 1
  else
    shasum -a 256 | cut -d ' ' -f 1
  fi
}

binary=$(command -v "$agentica") || { echo "agc-lsp: cannot find '$agentica'" >&2; exit 1; }
binary=$(realpath "$binary" 2> /dev/null || printf '%s' "$binary")
version=$("$binary" --version) || { echo "agc-lsp: cannot run '$agentica --version'" >&2; exit 1; }

key=$(
  export LC_ALL=C
  {
    printf '%s\n%s\n' "$binary" "$version"
    for source in "$root"/src/*.agc; do
      printf '%s\n' "${source##*/}"
      cat "$source"
    done
  } | digest
)
program=$cache/$key.agcb

mkdir -p "$cache"
touch -c "$program" 2> /dev/null || true
if [ ! -f "$program" ]; then
  find "$cache" -name 'compiling.*' -mmin +60 -delete 2> /dev/null || true
  partial=$(mktemp "$cache/compiling.XXXXXX")
  trap 'rm -f "$partial"' EXIT
  trap 'exit 1' HUP INT TERM
  if ! "$agentica" compile "$root/src/main.agc" -o "$partial" >&2; then
    exit 1
  fi
  mv "$partial" "$program"
  trap - EXIT HUP INT TERM
  find "$cache" -name '*.agcb' ! -path "$program" -mtime "+$keep_days" -delete 2> /dev/null || true
fi

exec "$agentica" run --allow-run -- "$program" "$@"
